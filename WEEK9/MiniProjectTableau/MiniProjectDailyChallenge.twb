      <column caption='2020 Units Sold' datatype='integer' name='[2020_units_sold]' role='measure' type='quantitative' />
      <column caption='2021 Start Stock' datatype='integer' name='[2021_start_stock]' role='measure' type='quantitative' />
      <column caption='Abc 2021' datatype='string' name='[ABC_2021]' role='dimension' type='nominal' />
      <column caption='Advertisement Costs' datatype='real' name='[Advertisement_Costs]' role='measure' type='quantitative' />
      <column caption='Country' datatype='string' name='[Calculation_876513113918885888]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRIM( SPLIT( [Customer_Country], &quot;_&quot;, 2 ) )' />
      </column>
      <column caption='Year' datatype='integer' name='[Calculation_876513113919709187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Year([Invoice_Date])' />
      </column>
      <column caption='Total Orders 21' datatype='integer' name='[Calculation_876513113919930372]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [Description]:SUM(IF [Calculation_876513113919709187] = 2021&#10;THEN [Quantity]&#10;END)}' />
      </column>
      <column caption='COGS 2021' datatype='real' name='[Calculation_876513114071740421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Raw_Material_Cost]+[Factory_Labor_Costs]+[Factory_Equipment_Rent_Costs])*[Calculation_876513113919930372]' />
      </column>
      <column caption='REVENUE 21' datatype='real' name='[Calculation_876513114072125446]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_876513113919930372] * [Retail_Price]' />
      </column>
      <column caption='PROFIT 2021' datatype='real' name='[Calculation_876513114072276999]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_876513114072125446]-[Calculation_876513114071740421]' />
      </column>
