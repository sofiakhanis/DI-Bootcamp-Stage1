    <worksheet name='Average Salary'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1'>Average salary for analytics</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='job_postings' name='federated.1icaeza07n7igg1dg641g1sfko50' />
          </datasources>
          <datasource-dependencies datasource='federated.1icaeza07n7igg1dg641g1sfko50'>
            <column caption='Analytics' datatype='string' name='[Calculation_675610349137575943]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS(LOWER([Job Title]), &quot;analyst&quot;) &#10;   OR CONTAINS(LOWER([Job Title]), &quot;analytics&quot;) &#10;THEN [Job Title]&#10;ELSE NULL&#10;END' />
            </column>
            <column caption='Salary Average' datatype='real' name='[Calculation_675610349187502090]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Minimum Pay] + [Maximum Pay]) / 2' />
            </column>
            <column datatype='string' name='[Job Title]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Maximum Pay]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Minimum Pay]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_675610349187502090]' derivation='Avg' name='[avg:Calculation_675610349187502090:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_675610349137575943]' derivation='None' name='[none:Calculation_675610349137575943:nk]' pivot='key' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1icaeza07n7igg1dg641g1sfko50].[none:Calculation_675610349137575943:nk]'>
            <groupfilter function='except' user:ui-domain='database' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:Calculation_675610349137575943:nk]' />
              <groupfilter function='union'>
                <groupfilter function='member' level='[none:Calculation_675610349137575943:nk]' member='%null%' />
                <groupfilter function='member' level='[none:Calculation_675610349137575943:nk]' member='&quot;Credit Analyst&quot;' />
                <groupfilter function='member' level='[none:Calculation_675610349137575943:nk]' member='&quot;Network Analyst&quot;' />
              </groupfilter>
            </groupfilter>
          </filter>
          <computed-sort column='[federated.1icaeza07n7igg1dg641g1sfko50].[none:Calculation_675610349137575943:nk]' direction='DESC' using='[federated.1icaeza07n7igg1dg641g1sfko50].[avg:Calculation_675610349187502090:qk]' />
          <slices>
            <column>[federated.1icaeza07n7igg1dg641g1sfko50].[none:Calculation_675610349137575943:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.1icaeza07n7igg1dg641g1sfko50].[none:Calculation_675610349137575943:nk]' />
