      <column caption='Profit Ratio' datatype='real' name='[Calculation_382031948067635201]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; 0 THEN SUM([Profit]) / SUM([Sales]) ELSE NULL END' />
      </column>
      <column caption='Rank1' datatype='integer' name='[Calculation_382031948069748738]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK_UNIQUE(SUM([Sales]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
